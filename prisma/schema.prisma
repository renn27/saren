// schema.prisma

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Garapan {
  id        String     @id @default(cuid())
  bulan     Int        // 1-12
  tahun     Int
  aplikasi  Aplikasi[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([bulan, tahun]) // cegah duplikat bulan+tahun yang sama
  @@map("garapan")
}

model Aplikasi {
  id           String   @id @default(cuid())
  garapanId    String?
  garapan      Garapan?  @relation(fields: [garapanId], references: [id], onDelete: Cascade)
  namaAplikasi String
  logoUrl      String?  // url dari Vercel Blob, nullable
  deskripsi    String?  // deskripsi aplikasi, nullable
  kolom        Kolom[]
  akun         Akun[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("aplikasi")
}

enum TipeKolom {
  TEKS
  NOMOR
  NOMINAL
  CENTANG
  TANGGAL
}

model Kolom {
  id         String    @id @default(cuid())
  aplikasiId String
  aplikasi   Aplikasi  @relation(fields: [aplikasiId], references: [id], onDelete: Cascade)
  namaKolom  String
  tipeKolom  TipeKolom
  urutan     Int       @default(0) // urutan tampil kolom, isi otomatis = jumlah kolom existing saat dibuat
  isTarget      Boolean   @default(false)
  nilaiTarget   String?
  isAccumulated Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@unique([aplikasiId, namaKolom]) // nama kolom unik per aplikasi
  @@map("kolom")
}

model Akun {
  id           String   @id @default(cuid())
  aplikasiId   String
  aplikasi     Aplikasi @relation(fields: [aplikasiId], references: [id], onDelete: Cascade)
  nama         String
  device       String?
  nomorHp      String?
  customValues Json     @default("{}") // { [kolomId]: string | number | boolean }
  urutan       Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("akun")
}

model Nomor {
  id         String   @id @default(cuid())
  provider   String
  nomorKartu String
  pulsa      Int      @default(0)
  masaAktif  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("nomor")
}

model Note {
  id                    String         @id @default(cuid())
  title                 String?
  content               String?        @db.Text
  isPinned              Boolean        @default(false)
  isArchived            Boolean        @default(false)
  isTrashed             Boolean        @default(false)
  color                 String         @default("default") // default, red, orange, yellow, green, teal, blue, darkblue, purple, pink, brown, gray
  isList                Boolean        @default(false)
  isTable               Boolean        @default(false)
  imageUrl              String?
  listItems             NoteListItem[]
  labels                Label[]        @relation("NoteLabels")
  folderId              String?
  folder                Folder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  reminderAt            DateTime?
  reminderMinutesBefore Int            @default(0)
  reminderSent          Boolean        @default(false)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([isTrashed, isArchived, isPinned])
  @@index([updatedAt])
  @@index([reminderSent, reminderAt])
  @@map("note")
}

model NoteListItem {
  id          String   @id @default(cuid())
  noteId      String
  note        Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  text        String
  isCompleted Boolean  @default(false)
  urutan      Int      @default(0)

  @@map("note_list_item")
}

model Label {
  id    String @id @default(cuid())
  name  String @unique
  notes Note[] @relation("NoteLabels")

  @@map("label")
}

model Folder {
  id        String   @id @default(cuid())
  name      String   @unique
  notes     Note[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("folder")
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("push_subscription")
}

